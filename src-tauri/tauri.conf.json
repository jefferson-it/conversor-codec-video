{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conversor de Vídeo TV 1080p",
  "version": "1.0.0",
  "identifier": "br.com.jefferson.conversor-video-tv1080p",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Conversor de Vídeo TV 1080p",
        "width": 920,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "nsis",
      "msi"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "shortDescription": "Conversor de vídeo para TV 1080p",
    "longDescription": "Conversor local de vídeo para TV 1080p usando FFmpeg nativo.",
    "category": "Utility"
  }
}
